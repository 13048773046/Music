# ===== Liuying Music proxy locations (production) ===
# 由自动安装程序生成；正式生效的反代规则（不含安装向导）。

# 后台 H5 / 采集 H5 / 经 /music 前缀访问后端（剥掉 /music 前缀）
location /music/ {
    proxy_pass http://127.0.0.1:__API_PORT__/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    client_max_body_size 100m;
}

# 业务接口（含音频流 206、WebSocket /api/ws）
location /api/ {
    proxy_pass http://127.0.0.1:__API_PORT__/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    set $liuying_conn "";
    if ($http_upgrade = "websocket") { set $liuying_conn "upgrade"; }
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $liuying_conn;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    client_max_body_size 100m;
}

# 分享短链
location /s/ {
    proxy_pass http://127.0.0.1:__API_PORT__/s/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
# ===== /Liuying Music proxy locations =====
