# ===== Liuying Music proxy locations (INSTALL-TIME, removed after success) ===

# 安装向导页面
location /install/ {
    proxy_pass http://127.0.0.1:__INSTALL_PORT__/install/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

# 安装向导 API
location /installapi/ {
    proxy_pass http://127.0.0.1:__INSTALL_PORT__/installapi/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    client_max_body_size 16m;
}

# 业务接口（安装自检用）
location /api/ {
    proxy_pass http://127.0.0.1:__API_PORT__/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /music/ {
    proxy_pass http://127.0.0.1:__API_PORT__/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
# ===== /Liuying Music proxy locations =====
